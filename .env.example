# ==============================================================================
# Viral Shorts Studio - Environment Configuration Template
# Copy this file to .env and adjust variables as required for your environment.
# ==============================================================================

# Server Network Configuration
# Set HOST to 0.0.0.0 in Docker and cloud containers to allow external connections.
HOST=0.0.0.0
PORT=5000

# Environment Mode
# Set to 'production' on cloud/Docker deployments; 'development' for local desktop testing.
ENVIRONMENT=production

# Desktop Integration Controls
# When set to '0' or 'false', disables automatic desktop browser launch on startup.
OPEN_BROWSER=0

# Security Controls
# When set to '0' or 'false' (recommended in production), disables /api/check-local to prevent host filesystem probing.
ALLOW_LOCAL_PATH_CHECK=0

# FFmpeg Executable Override (Optional)
# In Linux/Docker, FFmpeg is automatically discovered from /usr/bin/ffmpeg or PATH.
# FFMPEG_PATH=/usr/bin/ffmpeg

# AI Speech Recognition (Whisper) Settings (Optional)
# Model size: 'tiny' (fastest, ~75MB, recommended for CPU), 'base', 'small', 'medium', 'large-v3'
WHISPER_MODEL=tiny
# Device: 'cpu' (default) or 'cuda' (for NVIDIA GPU acceleration)
WHISPER_DEVICE=cpu
# Compute type: 'int8' (fastest on CPU), 'float16' (for GPU), 'float32'
WHISPER_COMPUTE_TYPE=int8

# Background Video Processing & Job Queue Configuration
# Directory storing persistent jobs.db SQLite database
DATA_DIR=/app/output
# Maximum simultaneous video renders (Default: 1 to prevent CPU starvation)
MAX_CONCURRENT_RENDERS=1
# Retention period in hours before completed/failed jobs are automatically pruned
JOB_RETENTION_HOURS=72

# yt-dlp Anti-Bot & Proxy Configuration (Optional - for cloud/datacenter IP ranges)
# If your cloud provider's IP range is challenged or blocked by YouTube, configure a proxy:
# YTDLP_PROXY=http://username:password@proxy.example.com:8080
# Alternatively, provide a path to an exported YouTube cookies.txt file:
# YTDLP_COOKIES_FILE=/app/cookies.txt
